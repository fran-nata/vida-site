---
import { site } from '../lib/site';
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
---
<a
  id="call-now-btn"
  href={site.phoneHref}
  class="btn-glow group fixed right-4 sm:right-6 z-40 bg-accent text-white p-3.5 sm:pl-4 sm:pr-5 sm:py-3.5 rounded-full shadow-lg font-bold text-sm flex items-center gap-2"
  style="opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 300ms ease, transform 300ms ease, bottom 300ms ease;"
  aria-label={isEn ? `Call Vida Vitres at ${site.phone}` : `Appeler Vida Vitres au ${site.phone}`}
>
  <span class="flex items-center gap-2 transition-transform duration-200 group-hover:scale-105">
    <svg class="animate-pulse" width="18" height="18" viewBox="0 0 24 24" fill="black" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
    <span class="hidden sm:inline">{isEn ? 'Call now' : 'Appeler maintenant'}</span>
  </span>
</a>

<style>
  #call-now-btn {
    bottom: calc(1rem + var(--cookie-offset, 0px));
  }
  @media (min-width: 640px) {
    #call-now-btn {
      bottom: calc(1.5rem + var(--cookie-offset, 0px));
    }
  }
</style>

<script>
  const btn = document.getElementById('call-now-btn');
  if (btn) {
    const onScroll = () => {
      const visible = window.scrollY > 400;
      btn.style.opacity = visible ? '1' : '0';
      btn.style.transform = visible ? 'translateY(0)' : 'translateY(12px)';
      btn.style.pointerEvents = visible ? 'auto' : 'none';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
