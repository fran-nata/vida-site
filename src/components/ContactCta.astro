---
import { site } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Obtenez votre estimation gratuite',
  description = 'Réponse rapide, sans engagement.',
} = Astro.props;
---
<section id="contact" class="bg-accent px-8 py-18 text-center">
  <div class="max-w-[640px] mx-auto">
    <h2 class="font-heading text-[30px] font-extrabold text-white mb-4">{title}</h2>
    <p class="text-base leading-relaxed text-white/95 mb-7">{description}</p>
    <a href={site.phoneHref} class="inline-block bg-white text-accent px-7 py-3.5 rounded-[4px] text-[15px] font-bold">Appeler {site.phone}</a>
  </div>
</section>
