<section id="estimateur" class="bg-navy px-5 sm:px-8 py-14 sm:py-22">
  <div class="max-w-[720px] mx-auto text-center mb-10 reveal">
    <p class="text-[13px] font-bold tracking-wide uppercase text-accent-light mb-3">Outil d'estimation</p>
    <h2 class="font-heading text-[26px] sm:text-[32px] font-bold text-white tracking-tight mb-4">Calculez le coût de votre projet</h2>
    <p class="text-base leading-relaxed text-footer-muted">Répondez à quelques questions rapides pour obtenir une fourchette de prix indicative et réserver votre évaluation gratuite.</p>
  </div>

  <div class="max-w-[560px] mx-auto reveal reveal-d1">
    <iframe
      id="estimator-iframe"
      data-src="https://vitres-quiz.vibepreview.com/"
      loading="lazy"
      width="100%"
      height="680"
      style="border:none; border-radius:16px; box-shadow:0 10px 30px rgba(0,0,0,0.15); max-width: 100%;"
      title="Vida Vitres — Estimateur de Pellicule pour Fenêtres"
    ></iframe>
  </div>
</section>

<script>
  const iframe = document.getElementById('estimator-iframe');
  if (iframe instanceof HTMLIFrameElement) {
    const loadIframe = () => {
      const src = iframe.dataset.src;
      if (src && !iframe.src) iframe.src = src;
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadIframe();
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '400px 0px' }
      );
      io.observe(iframe);
    } else {
      loadIframe();
    }
  }
</script>
