---
import ProjectImage from './ProjectImage.astro';
import { publishedProjects } from '../data/projects';
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
const project = publishedProjects[0];
const copy = project?.[lang];
const href = project ? (isEn ? `/en/projects/${copy.slug}/` : `/projets/${copy.slug}/`) : '';
const indexHref = isEn ? '/en/projects/' : '/projets/';
---
{project && (
  <section class="bg-bg-light px-5 sm:px-8 py-14 sm:py-22">
    <div class="max-w-[1240px] mx-auto">
      <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 text-center reveal">{isEn ? 'Projects & results' : 'Projets et résultats'}</p>
      <h2 class="font-heading text-[26px] sm:text-[32px] font-bold tracking-tight mb-4 text-center reveal reveal-d1">{isEn ? 'Featured project' : 'Projet à la une'}</h2>
      <p class="text-base leading-relaxed text-muted mb-10 text-center max-w-[560px] mx-auto reveal reveal-d2">{isEn ? 'A real project, told simply: the problem, what we installed and what the client noticed.' : "Un projet réel, raconté simplement : le problème, ce que nous avons posé et ce que le client constate."}</p>
      <article class="group grid lg:grid-cols-[1.1fr_1fr] bg-white border border-border rounded-2xl overflow-hidden transition-shadow duration-300 hover:shadow-xl reveal reveal-d3">
        <a href={href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
          <div class="transition-transform duration-500 group-hover:scale-105">
            <ProjectImage src={`${project.mediaDir}/${project.media.hero.file}`} alt={project.media.hero.alt[lang]} lang={lang} aspect="aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[340px]" />
          </div>
        </a>
        <div class="p-6 sm:p-9 flex flex-col justify-center">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-navy text-white text-[11px] font-bold px-2.5 py-1 rounded-full">{copy.overview[0].value}</span>
            <span class="bg-bg-light text-navy text-[11px] font-bold px-2.5 py-1 rounded-full">{copy.overview[1].value}</span>
            <span class="bg-bg-light text-navy text-[11px] font-bold px-2.5 py-1 rounded-full">{copy.overview[2].value}</span>
          </div>
          <h3 class="font-heading text-[21px] sm:text-[24px] font-bold tracking-tight leading-snug mb-3">{copy.title}</h3>
          <p class="text-[15px] leading-relaxed text-muted mb-5">{copy.cardSummary}</p>
          <ul class="text-sm text-muted space-y-2 mb-7">
            {copy.results.points.map((p) => <li class="flex items-start gap-2"><span class="text-accent mt-0.5">✓</span> {p.title}</li>)}
          </ul>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={href} class="btn-glow inline-block px-6 py-3 rounded-[10px] text-[15px] font-bold text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">{isEn ? 'See the project →' : 'Voir le projet →'}</a>
            <a href={indexHref} class="text-[14px] font-semibold text-navy hover:text-accent transition-colors duration-200">{isEn ? 'All projects' : 'Tous les projets'}</a>
          </div>
        </div>
      </article>
    </div>
  </section>
)}
