---
import { site } from '../lib/site';
import { services } from '../data/services';
import { cities } from '../data/cities';

const popularCities = cities.slice(0, 3);
---
<footer class="bg-ink-dark text-footer-muted px-8 pt-14 pb-8">
  <div class="max-w-[1240px] mx-auto">
    <div class="grid grid-cols-4 gap-8 mb-10">
      <div>
        <div class="font-heading font-extrabold text-lg text-white mb-3">{site.name}</div>
        <p class="text-sm leading-relaxed max-w-[280px]">Spécialiste en pellicules architecturales pour fenêtres plates. Montréal &amp; environs.</p>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Services</div>
        <div class="flex flex-col gap-2.5 text-sm">
          {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
        </div>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Régions populaires</div>
        <div class="flex flex-col gap-2.5 text-sm">
          {popularCities.map((c) => <a href={`/locations/${c.slug}/`}>{c.name}</a>)}
          <a href="/locations/">Toutes les régions →</a>
        </div>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Contact</div>
        <div class="flex flex-col gap-2.5 text-sm">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={site.emailHref}>{site.email}</a>
          <a href="/blog/">Blogue</a>
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 text-[13px]">© 2026 {site.name}. Tous droits réservés.</div>
  </div>
</footer>
