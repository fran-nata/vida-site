---
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { services } from '../data/services';
import { cities } from '../data/cities';

const popularCities = cities.slice(0, 3);
---
<footer class="bg-navy text-footer-muted px-5 sm:px-8 pt-12 sm:pt-14 pb-8">
  <div class="max-w-[1240px] mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
      <div>
        <Logo variant="dark" class="mb-3" />
        <p class="text-sm leading-relaxed max-w-[280px] mt-4">Spécialiste en pellicules architecturales pour fenêtres plates. Montréal &amp; environs.</p>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Services</div>
        <div class="flex flex-col gap-2.5 text-sm">
          {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
          <a href="/vitres-teintees/">Vitres teintées résidentielles</a>
          <a href="/produits/">Nos produits Tekton</a>
        </div>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Régions populaires</div>
        <div class="flex flex-col gap-2.5 text-sm">
          {popularCities.map((c) => <a href={`/locations/${c.slug}/`}>{c.name}</a>)}
          <a href="/locations/">Toutes les régions →</a>
        </div>
      </div>
      <div>
        <div class="text-[13px] font-bold text-white mb-3.5">Contact</div>
        <div class="flex flex-col gap-2.5 text-sm">
          <span class="flex items-center gap-2"><span aria-hidden="true">📍</span> Montréal &amp; environs, Québec</span>
          <a href={site.phoneHref} class="flex items-center gap-2"><span aria-hidden="true">📞</span> {site.phone}</a>
          <a href={site.emailHref} class="flex items-center gap-2"><span aria-hidden="true">✉️</span> {site.email}</a>
          <a href="/blog/">Blogue</a>
        </div>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 flex items-center justify-between flex-wrap gap-3 text-[13px]">
      <span>© 2026 {site.name}. Tous droits réservés.</span>
      <div class="flex items-center gap-5 flex-wrap">
        <a href="/politique-de-confidentialite/" class="text-footer-muted hover:text-white transition-colors duration-200">Politique de confidentialité</a>
        <a href="/conditions-utilisation/" class="text-footer-muted hover:text-white transition-colors duration-200">Conditions d'utilisation</a>
        <span class="text-footer-muted">Pellicules Tekton Performance Films</span>
      </div>
    </div>
  </div>
</footer>
