---
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { services } from '../data/services';
import { servicesEn } from '../data/servicesEn';
import { cities } from '../data/cities';

interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
const popularCities = cities.slice(0, 3);
---
<footer class="bg-navy text-footer-muted px-5 sm:px-8 pt-12 sm:pt-14 pb-8">
  <div class="max-w-[1240px] mx-auto">
    {isEn ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        <div>
          <Logo variant="dark" class="mb-3" href="/en/" />
          <p class="text-sm leading-relaxed max-w-[280px] mt-4">Architectural window film specialist for flat glass. Montreal &amp; surrounding areas.</p>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Services</div>
          <div class="flex flex-col gap-2.5 text-sm">
            {servicesEn.map((s) => <a href={`/en/services/${s.slug}/`}>{s.name}</a>)}
            <a href="/en/house-window-tint/">House Window Tint</a>
            <a href="/en/products/">Our Tekton Products</a>
          </div>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Popular Areas</div>
          <div class="flex flex-col gap-2.5 text-sm">
            {popularCities.map((c) => <a href={`/en/locations/${c.slug}/`}>{c.name}</a>)}
            <a href="/en/locations/">All areas →</a>
          </div>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Contact</div>
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="flex items-center gap-2"><span aria-hidden="true">📍</span> Montreal &amp; surrounding areas, Quebec</span>
            <a href={site.phoneHref} class="flex items-center gap-2"><span aria-hidden="true">📞</span> {site.phone}</a>
            <a href={site.emailHref} class="flex items-center gap-2"><span aria-hidden="true">✉️</span> {site.email}</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
        <div>
          <Logo variant="dark" class="mb-3" />
          <p class="text-sm leading-relaxed max-w-[280px] mt-4">Spécialiste en pellicules architecturales pour fenêtres plates. Montréal &amp; environs.</p>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Services</div>
          <div class="flex flex-col gap-2.5 text-sm">
            {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
            <a href="/vitres-teintees/">Vitres teintées résidentielles</a>
            <a href="/produits/">Nos produits Tekton</a>
          </div>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Régions populaires</div>
          <div class="flex flex-col gap-2.5 text-sm">
            {popularCities.map((c) => <a href={`/locations/${c.slug}/`}>{c.name}</a>)}
            <a href="/locations/">Toutes les régions →</a>
          </div>
        </div>
        <div>
          <div class="text-[13px] font-bold text-white mb-3.5">Contact</div>
          <div class="flex flex-col gap-2.5 text-sm">
            <span class="flex items-center gap-2"><span aria-hidden="true">📍</span> Montréal &amp; environs, Québec</span>
            <a href={site.phoneHref} class="flex items-center gap-2"><span aria-hidden="true">📞</span> {site.phone}</a>
            <a href={site.emailHref} class="flex items-center gap-2"><span aria-hidden="true">✉️</span> {site.email}</a>
            <a href="/blog/">Blogue</a>
          </div>
        </div>
      </div>
    )}
    <div class="border-t border-white/10 pt-6 flex items-center justify-between flex-wrap gap-3 text-[13px]">
      <span>© 2026 {site.name}. {isEn ? 'All rights reserved.' : 'Tous droits réservés.'}</span>
      <div class="flex items-center gap-5 flex-wrap">
        <a href={isEn ? '/en/privacy-policy/' : '/politique-de-confidentialite/'} class="text-footer-muted hover:text-white transition-colors duration-200">{isEn ? 'Privacy Policy' : 'Politique de confidentialité'}</a>
        <a href={isEn ? '/en/terms-of-use/' : '/conditions-utilisation/'} class="text-footer-muted hover:text-white transition-colors duration-200">{isEn ? 'Terms of Use' : "Conditions d'utilisation"}</a>
        <span class="text-footer-muted">Tekton Performance Films</span>
      </div>
    </div>
  </div>
</footer>
