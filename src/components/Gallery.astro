---
import ImagePlaceholder from './ImagePlaceholder.astro';
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const itemsFr = [
  {
    tag: 'Intimité',
    hue: 280,
    caption: 'Façade commerciale — pellicule d\'intimité réfléchissante, Montréal',
    src: '/images/pellicule-intimite-fenetre-reflechissante-immeuble-montreal.jpg',
  },
  {
    tag: 'Résidentiel',
    hue: 230,
    caption: 'Quartier résidentiel du Grand Montréal au coucher du soleil',
    src: '/images/quartier-residentiel-grand-montreal-pellicule-fenetre.jpg',
  },
  {
    tag: 'Décoratif',
    hue: 150,
    caption: 'Bureau — cloison en verre givré, Montréal',
    src: '/images/pellicule-decorative-cloison-bureau-givree-montreal.jpg',
  },
  {
    tag: 'Solaire',
    hue: 230,
    caption: 'Fenêtres panoramiques avec pellicule solaire, vue sur Montréal',
    src: '/images/fenetres-panoramiques-condo-montreal-pellicule-solaire.webp',
  },
];

const itemsEn = [
  {
    tag: 'Privacy',
    hue: 280,
    caption: 'Commercial facade — reflective privacy window film, Montreal',
    src: '/images/pellicule-intimite-fenetre-reflechissante-immeuble-montreal.jpg',
  },
  {
    tag: 'Residential',
    hue: 230,
    caption: 'Residential neighborhood in Greater Montreal at sunset',
    src: '/images/quartier-residentiel-grand-montreal-pellicule-fenetre.jpg',
  },
  {
    tag: 'Decorative',
    hue: 150,
    caption: 'Office — frosted glass partition, Montreal',
    src: '/images/pellicule-decorative-cloison-bureau-givree-montreal.jpg',
  },
  {
    tag: 'Heat control',
    hue: 230,
    caption: 'Panoramic windows with heat control film, Montreal view',
    src: '/images/fenetres-panoramiques-condo-montreal-pellicule-solaire.webp',
  },
];

const items = isEn ? itemsEn : itemsFr;
---
<section class="max-w-[1240px] mx-auto px-5 sm:px-8 py-14 sm:py-22">
  <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 text-center reveal">{isEn ? 'Our Work' : 'Réalisations'}</p>
  <h2 class="font-heading text-[26px] sm:text-[32px] font-bold tracking-tight mb-4 text-center reveal reveal-d1">{isEn ? 'See the difference' : 'Voyez la différence'}</h2>
  <p class="text-base leading-relaxed text-muted mb-11 text-center max-w-[560px] mx-auto reveal reveal-d2">{isEn ? 'Residential and commercial applications that transform spaces, concretely.' : 'Des applications résidentielles et commerciales qui transforment concrètement les espaces.'}</p>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    {items.map((item, i) => (
      <div class={`group rounded-2xl overflow-hidden border border-border relative transition-shadow duration-300 hover:shadow-xl reveal reveal-d${Math.min(i + 1, 8)}`}>
        <div class="transition-transform duration-500 group-hover:scale-110">
          <ImagePlaceholder caption={item.caption} hue={item.hue} aspect="aspect-[3/4]" class="rounded-none" src={item.src} />
        </div>
        <span class="absolute top-3 left-3 bg-navy text-white text-[11px] font-bold px-2.5 py-1 rounded-full transition-transform duration-300 group-hover:scale-105">{item.tag}</span>
        <div class="absolute bottom-0 inset-x-0 bg-navy/85 text-white text-[12px] font-medium px-3 py-2.5 transition-transform duration-300 group-hover:translate-y-0 translate-y-1">{item.caption}</div>
      </div>
    ))}
  </div>
</section>
