---
import ImagePlaceholder from './ImagePlaceholder.astro';

const items = [
  { tag: 'Intimité', hue: 280, caption: 'Salle de bain — pellicule d\'intimité givrée' },
  { tag: 'Résidentiel', hue: 230, caption: 'Porte d\'entrée — film sur vitres latérales' },
  { tag: 'Décoratif', hue: 150, caption: 'Bureau — cloison en verre givré' },
  { tag: 'Solaire', hue: 230, caption: 'Fenêtres résidentielles — pellicule solaire' },
];
---
<section class="max-w-[1240px] mx-auto px-8 py-22">
  <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 text-center">Réalisations</p>
  <h2 class="font-heading text-[32px] font-bold tracking-tight mb-4 text-center">Voyez la différence</h2>
  <p class="text-base leading-relaxed text-muted mb-11 text-center max-w-[560px] mx-auto">Des applications résidentielles et commerciales qui transforment concrètement les espaces.</p>
  <div class="grid grid-cols-4 gap-5">
    {items.map((item) => (
      <div class="rounded-2xl overflow-hidden border border-border relative">
        <ImagePlaceholder caption={item.caption} hue={item.hue} aspect="aspect-[3/4]" class="rounded-none" />
        <span class="absolute top-3 left-3 bg-navy text-white text-[11px] font-bold px-2.5 py-1 rounded-full">{item.tag}</span>
        <div class="absolute bottom-0 inset-x-0 bg-navy/85 text-white text-[12px] font-medium px-3 py-2.5">{item.caption}</div>
      </div>
    ))}
  </div>
</section>
