---
import type { City } from '../data/cities';
interface Props {
  city: City;
  href?: string;
}
const { city, href = `/locations/${city.slug}/` } = Astro.props;
---
<a href={href} class="border border-border rounded-md px-4 py-3.5 text-sm font-semibold bg-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-accent hover:text-accent">{city.name}</a>
