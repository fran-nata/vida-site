---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
  href?: string;
}
const { variant = 'light', class: className = '', href = '/' } = Astro.props;
// Full "VIDA VITRES" lockup for light backgrounds (header). The footer is
// dark navy, where the full lockup's black "VITRES" text and one V-stroke
// have weak contrast, so it uses the VIDA-only mark instead (still has a
// dark stroke on the V, but reads much cleaner without the extra text).
const src = variant === 'dark' ? '/images/vida-vitres-logo-mark.webp' : '/logo.webp';
const width = variant === 'dark' ? '126' : '180';
const height = variant === 'dark' ? '41' : '41';
---
<a href={href} class={`inline-flex items-center ${className}`} aria-label="Vida Vitres — Accueil">
  <img
    src={src}
    alt="Vida Vitres — pellicules pour fenêtres à Montréal et environs"
    width={width}
    height={height}
    class="h-9 w-auto transition-transform duration-300 hover:scale-105"
  />
</a>
