---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}
const { class: className = '' } = Astro.props;
// Only a light-background version of the logo has been provided so far.
// It's used as-is on the dark navy footer too (the "VITRES" text and one
// stroke of the mark are dark, so contrast is weaker there) until a
// reversed/light version is available.
---
<a href="/" class={`inline-flex items-center ${className}`} aria-label="Vida Vitres — Accueil">
  <img
    src="/logo.png"
    alt="Vida Vitres — pellicules pour fenêtres à Montréal et environs"
    width="180"
    height="41"
    class="h-9 w-auto transition-transform duration-300 hover:scale-105"
  />
</a>
