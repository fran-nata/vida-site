---
import ProjectImage from './ProjectImage.astro';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
  lang?: 'fr' | 'en';
}
const { project, lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
const copy = project[lang];
const href = isEn ? `/en/projects/${copy.slug}/` : `/projets/${copy.slug}/`;
const hero = project.media.hero;
const typeLabel = copy.overview[0].value;
const tags = [copy.overview[1].value, copy.overview[2].value];
---
<article class="group grid md:grid-cols-2 bg-white border border-border rounded-2xl overflow-hidden transition-shadow duration-300 hover:shadow-xl reveal">
  <a href={href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <div class="transition-transform duration-500 group-hover:scale-105">
      <ProjectImage src={`${project.mediaDir}/${hero.file}`} alt={hero.alt[lang]} lang={lang} aspect="aspect-[4/3] md:aspect-auto md:h-full md:min-h-[320px]" />
    </div>
  </a>
  <div class="p-6 sm:p-9 flex flex-col justify-center">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="bg-navy text-white text-[11px] font-bold px-2.5 py-1 rounded-full">{typeLabel}</span>
      {tags.map((t) => <span class="bg-bg-light text-navy text-[11px] font-bold px-2.5 py-1 rounded-full">{t}</span>)}
    </div>
    <h2 class="font-heading text-[22px] sm:text-[26px] font-bold tracking-tight leading-snug mb-3">
      <a href={href} class="hover:text-accent transition-colors duration-200">{copy.title}</a>
    </h2>
    <p class="text-[15px] leading-relaxed text-muted mb-6">{copy.cardSummary}</p>
    <div>
      <a href={href} class="btn-glow inline-block px-6 py-3 rounded-[10px] text-[15px] font-bold text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">{isEn ? 'Read the case study →' : "Lire l'étude de cas →"}</a>
    </div>
  </div>
</article>
