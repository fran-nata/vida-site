---
import ProjectImage from './ProjectImage.astro';
import { mediaExists } from '../lib/media';
import { site } from '../lib/site';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
  lang?: 'fr' | 'en';
}
const { project, lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
const copy = project[lang];
const dir = project.mediaDir;
const hero = project.media.hero;
const estimateHref = isEn ? '/en/#estimate' : '/#estimateur';
const indexHref = isEn ? '/en/projects/' : '/projets/';
const phoneLabel = isEn ? `Call ${site.phone}` : `Appeler ${site.phone}`;
const videos = project.media.videos.map((v) => ({
  ...v,
  src: `${dir}/${v.file}`,
  posterSrc: v.poster && mediaExists(`${dir}/${v.poster}`) ? `${dir}/${v.poster}` : undefined,
  exists: mediaExists(`${dir}/${v.file}`),
}));
if (import.meta.env.PROD) videos.filter((v) => !v.exists).forEach((v) => console.warn(`[projects] missing media: public${v.src}`));
---
<!-- Hero -->
<section class="max-w-[1000px] mx-auto px-5 sm:px-8 pt-8 sm:pt-10 pb-8 text-center">
  <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 reveal">{isEn ? 'Case study' : "Étude de cas"} · {copy.overview[0].value}</p>
  <h1 class="font-heading text-[28px] sm:text-[42px] font-extrabold tracking-tight leading-tight mb-5 reveal reveal-d1">{copy.title}</h1>
  <p class="text-[17px] leading-relaxed text-muted max-w-[720px] mx-auto reveal reveal-d2">{copy.intro}</p>
</section>
<section class="max-w-[1100px] mx-auto px-5 sm:px-8 pb-10 sm:pb-14">
  <div class="rounded-2xl overflow-hidden border border-border reveal reveal-d3">
    <ProjectImage src={`${dir}/${hero.file}`} alt={hero.alt[lang]} lang={lang} aspect="aspect-[4/3] sm:aspect-[16/9]" priority />
  </div>
</section>

<!-- Overview -->
<section class="max-w-[1100px] mx-auto px-5 sm:px-8 pb-12 sm:pb-16" aria-labelledby="overview-title">
  <h2 id="overview-title" class="sr-only">{isEn ? 'Project overview' : 'Aperçu du projet'}</h2>
  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4 reveal">
    {copy.overview.map((item) => (
      <div class="bg-white border border-border rounded-2xl p-5">
        <dt class="text-[12px] font-bold uppercase tracking-wide text-muted-2 mb-1.5">{item.label}</dt>
        <dd class="font-heading text-[16px] sm:text-[17px] font-bold text-navy leading-snug">{item.value}</dd>
      </div>
    ))}
  </dl>
</section>

<!-- Challenge -->
<section class="max-w-[1100px] mx-auto px-5 sm:px-8 pb-12 sm:pb-16">
  <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 reveal">{isEn ? 'The challenge' : 'Le défi'}</p>
  <h2 class="font-heading text-[24px] sm:text-[32px] font-bold tracking-tight mb-4 max-w-[760px] reveal reveal-d1">{isEn ? 'Bright premises, but too exposed and too warm' : 'Des locaux lumineux, mais trop exposés et trop chauds'}</h2>
  <p class="text-base leading-relaxed text-muted mb-8 max-w-[720px] reveal reveal-d2">{copy.challenge.intro}</p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {copy.challenge.points.map((p, i) => (
      <div class={`bg-white border border-border rounded-2xl p-6 reveal reveal-d${i + 1}`}>
        <div class="w-9 h-9 rounded-full bg-bg-light text-navy font-heading font-bold flex items-center justify-center mb-4" aria-hidden="true">{i + 1}</div>
        <h3 class="font-heading text-[17px] font-bold mb-2">{p.title}</h3>
        <p class="text-[15px] leading-relaxed text-muted">{p.text}</p>
      </div>
    ))}
  </div>
</section>

<!-- Intervention -->
<section class="bg-bg-light px-5 sm:px-8 py-12 sm:py-16">
  <div class="max-w-[1100px] mx-auto grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
    <div>
      <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 reveal">{isEn ? 'Our work' : 'Notre intervention'}</p>
      <h2 class="font-heading text-[24px] sm:text-[32px] font-bold tracking-tight mb-4 reveal reveal-d1">{isEn ? 'Reflective film, inside or outside the glass' : 'Une pellicule réfléchissante, à l’intérieur ou à l’extérieur du verre'}</h2>
      <p class="text-base leading-relaxed text-muted mb-6 reveal reveal-d2">{copy.intervention.intro}</p>
      <ul class="space-y-3 reveal reveal-d3">
        {copy.intervention.points.map((pt) => (
          <li class="flex items-start gap-3 text-[15px] text-ink"><span class="text-accent font-bold mt-0.5" aria-hidden="true">✓</span> <span>{pt}</span></li>
        ))}
      </ul>
    </div>
    <div class="bg-white border border-border rounded-2xl p-6 sm:p-8 reveal reveal-d2">
      <h3 class="font-heading text-[18px] font-bold mb-3">{copy.intervention.howItWorksTitle}</h3>
      <p class="text-[15px] leading-relaxed text-muted">{copy.intervention.howItWorks}</p>
    </div>
  </div>
</section>

<!-- Results -->
<section class="bg-navy px-5 sm:px-8 py-12 sm:py-16">
  <div class="max-w-[1100px] mx-auto">
    <p class="text-[13px] font-bold tracking-wide uppercase text-accent-light mb-3 reveal">{isEn ? 'Reported results' : 'Les résultats constatés'}</p>
    <h2 class="font-heading text-[24px] sm:text-[32px] font-bold text-white tracking-tight mb-4 max-w-[760px] reveal reveal-d1">{isEn ? 'What the clinic notices every day' : 'Ce que la clinique constate au quotidien'}</h2>
    <p class="text-base leading-relaxed text-footer-muted mb-8 max-w-[720px] reveal reveal-d2">{copy.results.intro}</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      {copy.results.points.map((p, i) => (
        <div class={`bg-white/5 border border-white/10 rounded-2xl p-6 reveal reveal-d${i + 1}`}>
          <h3 class="font-heading text-[17px] font-bold text-white mb-2">{p.title}</h3>
          <p class="text-[15px] leading-relaxed text-footer-muted">{p.text}</p>
        </div>
      ))}
    </div>
    <aside class="rounded-2xl border border-accent-light/40 bg-white/5 p-6 reveal" aria-labelledby="privacy-note-title">
      <h3 id="privacy-note-title" class="font-heading text-[16px] font-bold text-accent-light mb-2">{copy.results.privacyTitle}</h3>
      <p class="text-[14px] leading-relaxed text-footer-muted">{copy.results.privacyNote}</p>
    </aside>
  </div>
</section>

<!-- Before / after photos -->
<section class="max-w-[1100px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
  <h2 class="font-heading text-[24px] sm:text-[32px] font-bold tracking-tight mb-3 reveal">{copy.beforeAfter.title}</h2>
  <p class="text-base leading-relaxed text-muted mb-8 reveal reveal-d1">{copy.beforeAfter.intro}</p>
  <div class="space-y-8 sm:space-y-10">
    {project.media.pairs.map((pair) => (
      <figure class="reveal">
        <div class="grid sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="relative rounded-2xl overflow-hidden border border-border">
            <ProjectImage src={`${dir}/${pair.before.file}`} alt={pair.before.alt[lang]} lang={lang} aspect="aspect-[4/3]" />
            <span class="absolute top-3 left-3 bg-navy text-white text-[12px] font-bold px-3 py-1 rounded-full">{copy.beforeAfter.before}</span>
          </div>
          <div class="relative rounded-2xl overflow-hidden border border-border">
            <ProjectImage src={`${dir}/${pair.after.file}`} alt={pair.after.alt[lang]} lang={lang} aspect="aspect-[4/3]" />
            <span class="absolute top-3 left-3 bg-accent text-white text-[12px] font-bold px-3 py-1 rounded-full">{copy.beforeAfter.after}</span>
          </div>
        </div>
        <figcaption class="text-[13px] text-muted-2 mt-2.5">{pair.caption[lang]}</figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- Videos -->
<section class="bg-bg-light px-5 sm:px-8 py-12 sm:py-16">
  <div class="max-w-[1100px] mx-auto">
    <h2 class="font-heading text-[24px] sm:text-[32px] font-bold tracking-tight mb-3 reveal">{copy.videos.title}</h2>
    <p class="text-base leading-relaxed text-muted mb-8 max-w-[720px] reveal reveal-d1">{copy.videos.intro}</p>
    <div class="grid md:grid-cols-2 gap-6">
      {videos.map((v) => (
        <figure class="reveal">
          {v.exists ? (
            <video controls preload="metadata" playsinline poster={v.posterSrc} class="w-full aspect-video rounded-2xl border border-border bg-black">
              <source src={v.src} type="video/mp4" />
              {isEn ? 'Your browser cannot play this video.' : 'Votre navigateur ne peut pas lire cette vidéo.'}
            </video>
          ) : (
            <div role="img" aria-label={v.title[lang]} data-placeholder="true" class="aspect-video w-full rounded-2xl border border-border flex flex-col items-center justify-center gap-1 text-center p-5 font-mono text-[12px]" style="background: repeating-linear-gradient(135deg, oklch(0.93 0.02 280), oklch(0.93 0.02 280) 12px, oklch(0.9 0.03 280) 12px, oklch(0.9 0.03 280) 24px); color: oklch(0.35 0.04 280);">
              <span class="font-bold uppercase tracking-wide">{isEn ? 'Placeholder — video to be supplied' : 'Espace réservé — vidéo à fournir'}</span>
              <span class="break-all opacity-80">{v.src}</span>
            </div>
          )}
          <figcaption class="mt-3">
            <span class="font-heading text-[16px] font-bold text-navy">{v.title[lang]}</span>
            <span class="block text-[14px] text-muted">{v.description[lang]}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="bg-navy px-5 sm:px-8 py-14 sm:py-18 text-center overflow-hidden">
  <div class="max-w-[640px] mx-auto reveal">
    <h2 class="font-heading text-[24px] sm:text-[32px] font-bold text-white mb-3">{copy.cta.title}</h2>
    <p class="text-lg leading-relaxed text-footer-muted mb-7">{copy.cta.text}</p>
    <div class="flex gap-3.5 justify-center flex-wrap">
      <a href={estimateHref} class="btn-glow w-full sm:w-auto inline-block px-7 py-3.5 rounded-[10px] text-[15px] font-bold text-white transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">{copy.cta.button}</a>
      <a href={site.phoneHref} class="font-heading w-full sm:w-auto inline-block border-2 border-white text-white px-7 py-3.5 rounded-[10px] text-[15px] font-bold transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:text-navy active:translate-y-0">{phoneLabel}</a>
    </div>
    <p class="mt-8"><a href={indexHref} class="text-[14px] font-semibold text-footer-muted hover:text-white transition-colors duration-200">← {isEn ? 'All projects' : 'Tous les projets'}</a></p>
  </div>
</section>
