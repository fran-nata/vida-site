---
import type { Service } from '../data/services';
import ImagePlaceholder from './ImagePlaceholder.astro';
interface Props {
  service: Service;
  href?: string;
  index?: number;
  lang?: 'fr' | 'en';
}
const { service, href, index = 0, lang = 'fr' } = Astro.props;
const isEn = lang === 'en';
const resolvedHref = href ?? (isEn ? `/en/services/${service.slug}/` : `/services/${service.slug}/`);
const delayClass = index > 0 ? `reveal-d${Math.min(index, 8)}` : '';
---
<div class={`group border border-border rounded-2xl bg-white overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-transparent reveal ${delayClass}`}>
  <div class="relative overflow-hidden">
    <div class="transition-transform duration-500 group-hover:scale-110">
      <ImagePlaceholder caption={service.photoCaption} hue={service.hue} aspect="aspect-[4/3]" class="rounded-none" src={service.photo} />
    </div>
    <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm text-[11px] font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5">
      <span aria-hidden="true">{service.icon}</span> {service.tagline}
    </span>
  </div>
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-heading text-lg font-bold mb-2">{service.name}</h3>
    <p class="text-sm leading-relaxed text-muted mb-4">{service.cardDescription}</p>
    <ul class="text-[13px] text-muted space-y-1.5 mb-5">
      {service.benefits.slice(0, 4).map((b) => (
        <li class="flex items-center gap-2"><span class="text-accent">•</span> {b.title}</li>
      ))}
    </ul>
    <div class="mt-auto pt-4 border-t border-border flex items-center justify-between gap-3">
      <span class="text-[11px] text-muted-2">{service.tags}</span>
    </div>
    <a href={resolvedHref} class="mt-3 text-[13px] font-bold text-accent inline-flex items-center gap-1 transition-transform duration-200 group-hover:translate-x-1">{isEn ? 'Estimate & Booking →' : 'Estimation & Réservation →'}</a>
  </div>
</div>
