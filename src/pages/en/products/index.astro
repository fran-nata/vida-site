---
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { productsEn, productCategoriesEn } from '../../../data/productsEn';
---
<Layout
  title="Our Tekton Performance Films Products | Window Film | Vida Vitres"
  description="Explore the Tekton Performance Films we install: heat control, privacy, security, and decorative — with real performance data for each film."
  canonicalPath="/en/products/"
  lang="en"
  alternatePath="/produits/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/en/' }, { label: 'Products' }]} />

  <section class="max-w-[900px] mx-auto px-5 sm:px-8 pt-8 sm:pt-10 pb-10 sm:pb-14 text-center">
    <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 reveal">Official Tekton Performance Films Partner</p>
    <h1 class="font-heading text-[28px] sm:text-[42px] font-extrabold tracking-tight mb-5 reveal reveal-d1">What each film actually changes in your home</h1>
    <p class="text-[17px] leading-relaxed text-muted max-w-[680px] mx-auto reveal reveal-d2">
      No vague promises: every number below is a certified manufacturer spec, translated into a real-world result for your home or business — the light you keep, the heat you block, the privacy you gain.
    </p>
  </section>

  {productCategoriesEn.map((cat) => {
    const items = productsEn.filter((p) => p.category === cat.key);
    if (!items.length) return null;
    return (
      <section class="max-w-[1240px] mx-auto px-5 sm:px-8 pb-12 sm:pb-16">
        <div class="flex items-center gap-3 mb-7 reveal">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background: oklch(0.55 0.12 ${cat.hue})`}></span>
          <h2 class="font-heading text-[20px] sm:text-[24px] font-bold tracking-tight">{cat.label}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-3">
          {items.map((product, i) => <ProductCard product={product} index={i} lang="en" />)}
        </div>
      </section>
    );
  })}

  <section class="bg-navy px-5 sm:px-8 py-12 sm:py-16">
    <div class="max-w-[900px] mx-auto text-center reveal">
      <p class="text-[13px] font-bold tracking-wide uppercase text-accent-light mb-3">Not sure which film to choose?</p>
      <h2 class="font-heading text-[22px] sm:text-[28px] font-bold text-white tracking-tight mb-4">Our technicians recommend the right film for your windows</h2>
      <p class="text-base leading-relaxed text-footer-muted max-w-[600px] mx-auto">
        Orientation, glass type, and how you use the room all shape the right choice. A free on-site estimate settles it in a few minutes.
      </p>
    </div>
  </section>

  <ContactCta title="Let's find the right film for your project" description="Free estimate and a personalized recommendation for your windows." lang="en" />
</Layout>
