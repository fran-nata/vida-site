---
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { publishedProjects } from '../../../data/projects';
---
<Layout
  title="Projects & Results | Window Film in Montreal | Vida Vitres"
  description="Real window film projects in the Montreal area: the starting challenge, what we installed and the results our clients notice day to day."
  canonicalPath="/en/projects/"
  lang="en"
  alternatePath="/projets/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/en/' }, { label: 'Projects & results' }]} />

  <section class="max-w-[900px] mx-auto px-5 sm:px-8 pt-8 sm:pt-10 pb-10 sm:pb-12 text-center">
    <p class="text-[13px] font-bold tracking-wide uppercase text-accent mb-3 reveal">Our work</p>
    <h1 class="font-heading text-[28px] sm:text-[42px] font-extrabold tracking-tight mb-5 reveal reveal-d1">Projects & results</h1>
    <p class="text-[17px] leading-relaxed text-muted max-w-[680px] mx-auto reveal reveal-d2">
      Real projects, told simply: the problem we started with, what we installed and what our clients notice every day.
    </p>
  </section>

  <section class="max-w-[1100px] mx-auto px-5 sm:px-8 pb-10 sm:pb-14">
    <div class="space-y-6">
      {publishedProjects.map((project) => <ProjectCard project={project} lang="en" />)}
    </div>
    <p class="text-center text-[14px] text-muted-2 mt-8 reveal">New projects are added as jobs wrap up, with each client's approval.</p>
  </section>

  <ContactCta lang="en" title="Your project could be next" description="Free estimate and a personalized recommendation based on your windows." />
</Layout>
