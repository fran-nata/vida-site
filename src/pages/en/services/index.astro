---
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { servicesEn } from '../../../data/servicesEn';
---
<Layout
  title="Window Film Services for Homes | Vida Vitres Montreal"
  description="Heat control, privacy, security, and decorative window film for residential and commercial windows in Montreal. Explore our 4 services."
  canonicalPath="/en/services/"
  lang="en"
  alternatePath="/services/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/en/' }, { label: 'Services' }]} />

  <section class="max-w-[1240px] mx-auto px-5 sm:px-8 pt-8 sm:pt-10 pb-14 sm:pb-22">
    <h1 class="font-heading text-[30px] sm:text-[42px] font-extrabold tracking-tight mt-4 mb-5">Our window film services</h1>
    <p class="text-[17px] leading-relaxed text-muted mb-11 max-w-[680px]">Four architectural window film solutions, installed with precision in Montreal and 17 surrounding areas.</p>
    <h2 class="sr-only">Our 4 window film services</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {servicesEn.map((s) => <ServiceCard service={s} lang="en" />)}
    </div>
  </section>

  <ContactCta lang="en" />
</Layout>
