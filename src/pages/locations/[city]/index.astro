---
import Layout from '../../../components/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LocationCard from '../../../components/LocationCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import { services } from '../../../data/services';
import { cities, nearbyCities, regionProfiles } from '../../../data/cities';
import { locationIntros } from '../../../data/locationIntros';
import { site } from '../../../lib/site';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const near = nearbyCities(city.slug, 6);
const profile = regionProfiles[city.region];
const nearNames = near.slice(0, 3).map((c) => c.name);
const [introLocal, introClose] = locationIntros[city.slug];

// These pages cover all 4 services, so any real photo we have works; rotate
// through the set (offset from the combo-page rotation) for variety.
const photoPool = [
  '/images/quartier-residentiel-grand-montreal-pellicule-fenetre.jpg',
  '/images/pellicule-solaire-fenetre-panoramique-salon-montreal.jpg',
  '/images/fenetres-panoramiques-condo-montreal-pellicule-solaire.jpg',
  '/images/comparaison-avant-apres-pellicule-solaire-maison-montreal.jpg',
  '/images/installation-pellicule-solaire-vue-montreal.jpg',
  '/images/reduction-eblouissement-chaleur-pellicule-solaire-fenetre.jpg',
  '/images/pellicule-intimite-fenetre-reflechissante-immeuble-montreal.jpg',
];
const cityIndex = cities.findIndex((c) => c.slug === city.slug);
const photo = photoPool[(cityIndex + 2) % photoPool.length];

const whyUs = [
  { title: 'Installation locale', description: `Techniciens qui se déplacent dans ${city.name}.` },
  { title: 'Estimation gratuite', description: 'Un devis clair avant chaque installation.' },
  { title: 'Pellicules Tekton', description: 'Produits haut de gamme, garantis fabricant.' },
  { title: 'Résidentiel & commercial', description: 'Maisons, condos, bureaux et commerces.' },
];

const solaire = services.find((s) => s.slug === 'pellicule-solaire')!;
const intimite = services.find((s) => s.slug === 'pellicule-intimite')!;
const securite = services.find((s) => s.slug === 'pellicule-securite')!;
const decorative = services.find((s) => s.slug === 'pellicule-decorative')!;

const localFaqs = [
  {
    question: `Quelle pellicule pour fenêtres est la plus demandée à ${city.name} ?`,
    answerText: `À ${city.name}, où l'on retrouve ${profile.buildingContext}, ${profile.exposureNote}. La pellicule solaire et la pellicule d'intimité sont donc les deux services les plus fréquemment demandés, souvent installées ensemble sur les mêmes fenêtres.`,
    answerHtml: `À ${city.name}, où l'on retrouve ${profile.buildingContext}, ${profile.exposureNote}. La <a href="/services/${solaire.slug}/${city.slug}/" class="text-accent font-semibold">pellicule solaire</a> et la <a href="/services/${intimite.slug}/${city.slug}/" class="text-accent font-semibold">pellicule d'intimité</a> sont donc les deux services les plus fréquemment demandés, souvent installées ensemble sur les mêmes fenêtres.`,
  },
  {
    question: `Vos techniciens se déplacent-ils directement chez moi à ${city.name} ?`,
    answerText: `Oui — l'évaluation sur place et l'installation se font toutes deux à votre adresse à ${city.name}, que ce soit pour ${profile.propertyTypes}. Aucun déplacement de votre part n'est requis, et l'estimation initiale est gratuite et sans engagement.`,
    answerHtml: `Oui — l'évaluation sur place et l'installation se font toutes deux à votre adresse à ${city.name}, que ce soit pour ${profile.propertyTypes}. Aucun déplacement de votre part n'est requis, et l'estimation initiale est gratuite et sans engagement.`,
  },
  {
    question: `Desservez-vous aussi les municipalités autour de ${city.name} ?`,
    answerText: `Oui, en plus de ${city.name}, nous couvrons notamment ${nearNames.join(', ')} et le reste du Grand Montréal. Nos techniciens planifient souvent plusieurs installations dans un même secteur la même semaine.`,
    answerHtml: `Oui, en plus de ${city.name}, nous couvrons notamment ${near.slice(0, 3).map((c) => `<a href="/locations/${c.slug}/" class="text-accent font-semibold">${c.name}</a>`).join(', ')} et le reste du Grand Montréal. Nos techniciens planifient souvent plusieurs installations dans un même secteur la même semaine.`,
  },
];
---
<Layout
  title={`Pellicule pour Fenêtres à ${city.name} | Solaire, Intimité, Sécurité | ${site.name}`}
  description={`Installation de pellicule solaire, d'intimité et de sécurité pour fenêtres à ${city.name} (${city.region}). Estimation gratuite. Résidentiel et commercial.`}
  canonicalPath={`/locations/${city.slug}/`}
>
  <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Régions', href: '/locations/' }, { label: city.name }]} />

  <section class="max-w-[1240px] mx-auto px-8 pt-10 pb-14 grid grid-cols-2 gap-14 items-center">
    <div class="hero-in">
      <p class="text-[13px] font-bold tracking-wide uppercase text-accent my-4">{city.name}</p>
      <h1 class="font-heading text-[42px] font-bold tracking-tight mb-5 max-w-[760px]">Pellicule pour fenêtres à {city.name}</h1>
      <p class="text-[17px] leading-relaxed text-muted mb-4 max-w-[680px]">{introLocal}</p>
      <p class="text-[17px] leading-relaxed text-muted mb-8 max-w-[680px]">{introClose}</p>
      <div class="flex gap-3.5 flex-wrap">
        <a href="#contact" class="bg-accent text-white px-7 py-4 rounded-[10px] text-[15px] font-bold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0">Obtenir mon estimation →</a>
        <a href={site.phoneHref} class="bg-navy text-white px-7 py-4 rounded-[10px] text-[15px] font-bold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0">Appeler maintenant</a>
      </div>
    </div>
    <div class="hero-in hero-in-d1">
      <ImagePlaceholder
        caption={`Installation de pellicule pour fenêtres résidentielles à ${city.name}`}
        hue={230}
        src={photo}
      />
    </div>
  </section>

  <section class="max-w-[1240px] mx-auto px-8 pb-14">
    <div class="grid grid-cols-4 gap-5">
      {services.map((s) => (
        <a href={`/services/${s.slug}/${city.slug}/`} class="block border border-border rounded-lg p-6 bg-white">
          <h3 class="font-heading text-[17px] font-bold mb-2">{s.name}</h3>
          <p class="text-sm leading-relaxed text-muted mb-3.5">{s.tagline}</p>
          <span class="text-[13px] font-bold text-accent">Voir le service à {city.name} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-[900px] mx-auto px-8 pb-16">
    <h2 class="font-heading text-2xl font-extrabold tracking-tight mb-4">Pellicule pour fenêtres à {city.name} : ce qui distingue votre secteur</h2>
    <p class="text-[15px] leading-relaxed text-muted mb-5">
      Le secteur de {city.name}, dans {city.region}, se caractérise surtout par {profile.buildingContext}. Dans ce contexte, {profile.exposureNote}. C'est pourquoi nos techniciens recommandent généralement une évaluation sur place plutôt qu'une estimation générique en ligne : le type de vitrage, l'orientation des fenêtres et l'usage de la pièce influencent directement le choix entre une <a href={`/services/${solaire.slug}/${city.slug}/`} class="text-accent font-semibold">pellicule solaire</a>, une <a href={`/services/${intimite.slug}/${city.slug}/`} class="text-accent font-semibold">pellicule d'intimité</a>, une <a href={`/services/${securite.slug}/${city.slug}/`} class="text-accent font-semibold">pellicule de sécurité</a> ou une <a href={`/services/${decorative.slug}/${city.slug}/`} class="text-accent font-semibold">pellicule décorative</a>.
    </p>
    <p class="text-[15px] leading-relaxed text-muted mb-5">
      Pour {profile.propertyTypes} à {city.name}, la pellicule solaire reste le point de départ le plus courant : elle réduit la chaleur qui s'accumule en après-midi et bloque jusqu'à 99% des rayons UV responsables de la décoloration des planchers et des meubles, sans changer l'apparence des fenêtres ni en réduire la clarté.
    </p>
    <p class="text-[15px] leading-relaxed text-muted">
      Lorsque l'intimité ou la sécurité sont la priorité — salle de bain donnant sur la rue, porte-fenêtre de rez-de-chaussée, vitrine commerciale — nos techniciens évaluent directement sur place à {city.name} pour recommander un fini givré, une pellicule de sécurité, ou une combinaison des deux selon la fenêtre concernée. Chaque installation est accompagnée d'une estimation gratuite et d'un devis clair avant tout engagement.
    </p>
  </section>

  <section class="bg-bg-light px-8 py-14">
    <div class="max-w-[1240px] mx-auto">
      <h2 class="font-heading text-[26px] font-extrabold tracking-tight mb-6">Pourquoi les résidents de {city.name} nous font confiance</h2>
      <div class="grid grid-cols-4 gap-6">
        {whyUs.map((item) => (
          <div><h4 class="text-[15px] font-bold mb-1.5">{item.title}</h4><p class="text-sm leading-relaxed text-muted">{item.description}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-[900px] mx-auto px-8 py-16">
    <h2 class="font-heading text-2xl font-extrabold tracking-tight mb-8">Questions fréquentes à {city.name}</h2>
    {localFaqs.map((f) => (
      <details class="border-b border-border py-5">
        <summary class="text-base font-bold cursor-pointer">{f.question}</summary>
        <p class="text-[15px] leading-relaxed text-muted mt-3.5 max-w-[700px]" set:html={f.answerHtml} />
      </details>
    ))}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: localFaqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answerText } })),
    })} />
  </section>

  <section class="max-w-[1240px] mx-auto px-8 py-22">
    <h2 class="font-heading text-2xl font-extrabold tracking-tight mb-5">Autres régions desservies près de {city.name}</h2>
    <div class="grid grid-cols-3 gap-2.5">
      {near.map((c) => <LocationCard city={c} />)}
    </div>
  </section>

  <ContactCta />
</Layout>
