---
import Layout from '../../../../components/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import LocationCard from '../../../../components/LocationCard.astro';
import ContactCta from '../../../../components/ContactCta.astro';
import ImagePlaceholder from '../../../../components/ImagePlaceholder.astro';
import { services } from '../../../../data/services';
import { cities, nearbyCities } from '../../../../data/cities';
import { comboIntros } from '../../../../data/comboIntros';
import { site } from '../../../../lib/site';

export function getStaticPaths() {
  const paths: { params: { service: string; city: string }; props: { service: (typeof services)[number]; city: (typeof cities)[number] } }[] = [];
  for (const service of services) {
    for (const city of cities) {
      paths.push({ params: { service: service.slug, city: city.slug }, props: { service, city } });
    }
  }
  return paths;
}

const { service, city } = Astro.props;
const otherServices = services.filter((s) => s.slug !== service.slug);
const near = nearbyCities(city.slug, 3);
const [introLocal, introClose] = comboIntros[service.slug][city.slug];

// Real photography exists for all 4 services now -- solaire is rotated
// (so its 17 combo pages aren't all identical); the other 3 have one
// photo each so far.
const solairePhotoPool = [
  '/images/fenetres-panoramiques-condo-montreal-pellicule-solaire.jpg',
  '/images/installation-pellicule-solaire-vue-montreal.jpg',
  '/images/reduction-eblouissement-chaleur-pellicule-solaire-fenetre.jpg',
  '/images/comparaison-avant-apres-pellicule-solaire-maison-montreal.jpg',
];
const singlePhotoByService: Record<string, string> = {
  'pellicule-intimite': '/images/pellicule-intimite-fenetre-reflechissante-immeuble-montreal.jpg',
  'pellicule-decorative': '/images/pellicule-decorative-cloison-bureau-givree-montreal.jpg',
  'pellicule-securite': '/images/pellicule-securite-vitre-fissuree-maintenue-montreal.jpg',
};
const cityIndex = cities.findIndex((c) => c.slug === city.slug);
const photo =
  service.slug === 'pellicule-solaire'
    ? solairePhotoPool[cityIndex % solairePhotoPool.length]
    : singlePhotoByService[service.slug];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  name: `${service.name} à ${city.name} | ${site.name}`,
  description: `${service.cardDescription} Disponible à ${city.name}.`,
  areaServed: city.name,
  provider: { '@type': 'LocalBusiness', name: site.name },
};
---
<Layout
  title={`${service.name} à ${city.name} | ${site.name}`}
  description={`Installation de ${service.name.toLowerCase()} pour fenêtres à ${city.name} (${city.region}). ${service.tagline}. Estimation gratuite, résidentiel et commercial.`}
  canonicalPath={`/services/${service.slug}/${city.slug}/`}
>
  <Breadcrumb items={[
    { label: 'Accueil', href: '/' },
    { label: service.name, href: `/services/${service.slug}/` },
    { label: city.name },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />

  <section class="max-w-[1240px] mx-auto px-8 pt-10 pb-14 grid grid-cols-2 gap-14 items-center">
    <div class="hero-in">
      <p class="text-[13px] font-bold tracking-wide uppercase text-accent my-4">{service.tagline} · {city.name}</p>
      <h1 class="font-heading text-[40px] font-bold tracking-tight mb-5 max-w-[760px]">{service.name} à {city.name}</h1>
      <p class="text-[17px] leading-relaxed text-muted mb-4 max-w-[680px]">{introLocal}</p>
      <p class="text-[17px] leading-relaxed text-muted mb-10 max-w-[680px]">{introClose}</p>
      <div class="flex gap-3.5 flex-wrap">
        <a href="#contact" class="bg-accent text-white px-7 py-4 rounded-[10px] text-[15px] font-bold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0">Obtenir mon estimation →</a>
        <a href={site.phoneHref} class="bg-navy text-white px-7 py-4 rounded-[10px] text-[15px] font-bold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg active:translate-y-0">Appeler maintenant</a>
      </div>
    </div>
    <div class="hero-in hero-in-d1">
      <ImagePlaceholder
        caption={`Installation de ${service.name.toLowerCase()} sur fenêtre résidentielle à ${city.name}`}
        hue={service.hue}
        src={photo}
      />
    </div>
  </section>

  <section class="max-w-[1240px] mx-auto px-8 pb-14">
    <div class="grid grid-cols-4 gap-5">
      {service.benefits.slice(0, 4).map((b, i) => (
        <div class={`transition-transform duration-300 hover:-translate-y-1 reveal reveal-d${i + 1}`}><h4 class="text-[15px] font-bold mb-1.5">{b.title}</h4><p class="text-sm leading-relaxed text-muted">{b.description}</p></div>
      ))}
    </div>
  </section>

  <section class="bg-bg-light px-8 py-14">
    <div class="max-w-[1240px] mx-auto">
      <h2 class="font-heading text-2xl font-extrabold tracking-tight mb-5">Autres services disponibles à {city.name}</h2>
      <div class="grid grid-cols-3 gap-2.5 mb-5">
        {otherServices.map((s) => <LocationCard city={{ slug: s.slug, name: s.name, region: '' }} href={`/services/${s.slug}/${city.slug}/`} />)}
      </div>
      <a href={`/locations/${city.slug}/`} class="text-sm font-bold text-accent">Voir tous nos services à {city.name} →</a>
    </div>
  </section>

  <ContactCta />
</Layout>
